{
  "name": "sugar-collage",
  "displayName": "Sugar Collage",
  "description": "Un scrapbook dulce y algo surreal para VS Code: temas pastel, íconos, notas, pomodoro y más.",
  "version": "0.1.0",
  "publisher": "val-velvaz",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/val-velvaz/Sugar"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "id": "Sugar Collage Dark",
        "label": "Sugar Collage Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sugar-collage-dark-color-theme.json"
      },
      {
        "id": "Sugar Collage Light – Algodón",
        "label": "Sugar Collage Light – Algodón",
        "uiTheme": "vs",
        "path": "./themes/sugar-collage-light-algodon-color-theme.json"
      },
      {
        "id": "Sugar Collage Light – Pistache",
        "label": "Sugar Collage Light – Pistache",
        "uiTheme": "vs",
        "path": "./themes/sugar-collage-light-pistache-color-theme.json"
      },
      {
        "id": "Sugar Collage Light – Lavanda",
        "label": "Sugar Collage Light – Lavanda",
        "uiTheme": "vs",
        "path": "./themes/sugar-collage-light-lavanda-color-theme.json"
      },
      {
        "id": "Sugar Collage Light – Crema",
        "label": "Sugar Collage Light – Crema",
        "uiTheme": "vs",
        "path": "./themes/sugar-collage-light-crema-color-theme.json"
      },
      {
        "id": "Sugar Collage Maximal",
        "label": "Sugar Collage Maximal",
        "uiTheme": "vs-dark",
        "path": "./themes/sugar-collage-maximal-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "sugar-collage-icons",
        "label": "Sugar Collage Icons",
        "path": "./themes/sugar-collage-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "sugarCollage.applyTypography",
        "title": "Aplicar configuración tipográfica recomendada",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.restoreTypography",
        "title": "Restaurar configuración tipográfica",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.selectTheme",
        "title": "Elegir variante de tema",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.showTodos",
        "title": "Mis pendientes",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.toggleWashi",
        "title": "Activar/desactivar cintas washi en comentarios",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.toggleIndentRainbow",
        "title": "Activar/desactivar indentación arcoíris",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.completeTag",
        "title": "Marcar pendiente como hecho",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.openScrapbook",
        "title": "Abrir Mi Scrapbook",
        "category": "Sugar Collage"
      },
      {
        "command": "sugarCollage.addNote",
        "title": "Nueva nota adhesiva",
        "category": "Sugar Collage"
      }
    ],
    "configuration": [
      {
        "title": "Tipografía",
        "properties": {
          "sugarCollage.typography.fontSize": {
            "type": "number",
            "default": 14,
            "minimum": 8,
            "maximum": 32,
            "markdownDescription": "Tamaño de letra del editor que aplica el comando **Aplicar configuración tipográfica recomendada**."
          },
          "sugarCollage.typography.lineHeight": {
            "type": "number",
            "default": 1.6,
            "minimum": 0,
            "maximum": 3,
            "markdownDescription": "Interlineado recomendado. Entre 0 y 8 se interpreta como multiplicador del tamaño de letra (1.6 = 160 %)."
          },
          "sugarCollage.typography.letterSpacing": {
            "type": "number",
            "default": 0.3,
            "minimum": -1,
            "maximum": 3,
            "markdownDescription": "Espaciado entre letras recomendado, en píxeles."
          }
        }
      },
      {
        "title": "Tema automático",
        "properties": {
          "sugarCollage.autoTheme.mode": {
            "type": "string",
            "enum": [
              "off",
              "hora",
              "sistema"
            ],
            "enumDescriptions": [
              "Desactivado: el tema no cambia solo.",
              "Cambia entre el tema claro y el oscuro según la hora del día.",
              "Sigue el modo claro/oscuro del sistema operativo (window.autoDetectColorScheme)."
            ],
            "default": "off",
            "markdownDescription": "Cambio automático de variante de tema. Se puede activar desde **Sugar Collage: Elegir variante de tema**."
          },
          "sugarCollage.autoTheme.lightTheme": {
            "type": "string",
            "enum": [
              "Sugar Collage Light – Algodón",
              "Sugar Collage Light – Pistache",
              "Sugar Collage Light – Lavanda",
              "Sugar Collage Light – Crema"
            ],
            "default": "Sugar Collage Light – Algodón",
            "description": "Tema claro que se usa de día o cuando el sistema está en modo claro."
          },
          "sugarCollage.autoTheme.darkTheme": {
            "type": "string",
            "enum": [
              "Sugar Collage Dark",
              "Sugar Collage Maximal"
            ],
            "default": "Sugar Collage Dark",
            "description": "Tema oscuro que se usa de noche o cuando el sistema está en modo oscuro."
          },
          "sugarCollage.autoTheme.dayStart": {
            "type": "string",
            "default": "07:00",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "patternErrorMessage": "Usa el formato HH:MM, por ejemplo 07:30.",
            "markdownDescription": "Hora (HH:MM) a partir de la cual se usa el tema claro en el modo **hora**."
          },
          "sugarCollage.autoTheme.nightStart": {
            "type": "string",
            "default": "19:30",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "patternErrorMessage": "Usa el formato HH:MM, por ejemplo 19:30.",
            "markdownDescription": "Hora (HH:MM) a partir de la cual se usa el tema oscuro en el modo **hora**."
          }
        }
      },
      {
        "title": "Cintas washi en comentarios",
        "properties": {
          "sugarCollage.washi.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Decora con cinta washi pastel los comentarios que empiezan con `TODO`, `FIXME`, `NOTE`, `HACK`, `IDEA` o `?`, en cualquier lenguaje."
          },
          "sugarCollage.washi.tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TODO",
                "FIXME",
                "NOTE",
                "HACK",
                "IDEA",
                "?"
              ]
            },
            "uniqueItems": true,
            "default": [
              "TODO",
              "FIXME",
              "NOTE",
              "HACK",
              "IDEA",
              "?"
            ],
            "markdownDescription": "Etiquetas que se decoran. Quita las que no quieras ver resaltadas."
          },
          "sugarCollage.washi.gutterIcons": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Muestra un ícono en el margen (cinta, curita, nota, cinta cruzada, estrella o burbuja) junto a cada etiqueta."
          }
        }
      },
      {
        "title": "Mis pendientes",
        "properties": {
          "sugarCollage.todos.exclude": {
            "type": "string",
            "default": "**/{node_modules,dist,out,build,.git,.venv,venv,__pycache__,target}/**",
            "markdownDescription": "Patrón glob de carpetas y archivos que **no** se revisan al buscar pendientes en el workspace."
          },
          "sugarCollage.todos.maxFiles": {
            "type": "number",
            "default": 3000,
            "minimum": 100,
            "maximum": 50000,
            "markdownDescription": "Número máximo de archivos que se revisan al buscar pendientes."
          }
        }
      },
      {
        "title": "Indentación arcoíris",
        "properties": {
          "sugarCollage.indent.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Colorea cada nivel de indentación con la paleta pastel en rotación."
          },
          "sugarCollage.indent.mode": {
            "type": "string",
            "enum": [
              "guias",
              "fondo"
            ],
            "enumDescriptions": [
              "Solo una guía vertical fina de color por nivel.",
              "Rellena el espacio de cada nivel con una banda de color."
            ],
            "default": "guias",
            "markdownDescription": "Cómo se dibuja la indentación: **guias** (líneas finas) o **fondo** (bandas de color)."
          },
          "sugarCollage.indent.opacity": {
            "type": "number",
            "default": 0.45,
            "minimum": 0.02,
            "maximum": 1,
            "markdownDescription": "Opacidad de las guías o bandas (0.02–1). En modo **fondo** se recomienda 0.1–0.2."
          },
          "sugarCollage.indent.intensity": {
            "type": "string",
            "enum": [
              "suave",
              "media",
              "viva"
            ],
            "enumDescriptions": [
              "Pastel puro: casi un susurro.",
              "Un poco más de color.",
              "Colores intensos del mismo matiz."
            ],
            "default": "suave",
            "markdownDescription": "Intensidad del color de cada nivel."
          },
          "sugarCollage.indent.excludeLanguages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "plaintext"
            ],
            "markdownDescription": "Lenguajes (languageId) en los que no se dibuja la indentación arcoíris."
          }
        }
      },
      {
        "title": "Scrapbook",
        "properties": {
          "sugarCollage.scrapbook.background": {
            "type": "string",
            "enum": [
              "cuadricula",
              "gingham",
              "liso"
            ],
            "enumDescriptions": [
              "Papel cuadriculado en azul cielo.",
              "Cuadros gingham rosa pastel.",
              "Sin estampado: solo el color del tema."
            ],
            "default": "cuadricula",
            "markdownDescription": "Fondo del panel **Mi Scrapbook**. También se cambia con los botones de su encabezado."
          },
          "sugarCollage.sparkleLevel": {
            "type": "number",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "enumDescriptions": [
              "Minimalista y profesional: sin destellos, inclinaciones ni estampados.",
              "Sutil: estampado de fondo y notas levemente inclinadas.",
              "Dulce (por defecto): además cintas washi y destellos ✦.",
              "Maximalista total: animaciones y todos los adornos."
            ],
            "default": 2,
            "markdownDescription": "Cuánta decoración aparece en los paneles de Sugar Collage (0 = minimalista, 3 = maximalista). No afecta al editor."
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sugarCollage.completeTag",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sugarCollage",
          "title": "Sugar Collage",
          "icon": "media/activity/scrapbook.svg"
        }
      ]
    },
    "views": {
      "sugarCollage": [
        {
          "type": "webview",
          "id": "sugarCollage.scrapbook",
          "name": "Mi Scrapbook"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run generate:themes && npm run generate:icons && npm run check:contrast && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "generate:themes": "tsx scripts/build-themes.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "preview:themes": "tsx scripts/preview-themes.ts",
    "generate:icons": "tsx scripts/build-icons.ts",
    "preview:icons": "tsx scripts/preview-icons.ts",
    "preview:decorations": "tsx scripts/preview-decorations.ts",
    "generate:fonts": "tsx scripts/copy-fonts.ts",
    "preview:scrapbook": "npm run build && tsx scripts/preview-scrapbook.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
