  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#C5C6E4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#C38CFF"
      }
    },
    {
      "name": "Operadores y puntuación",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#B9B2B6"
      }
    },
    {
      "name": "Operadores con palabra",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.star.sql"
      ],
      "settings": {
        "foreground": "#C38CFF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8CFF3A"
      }
    },
    {
      "name": "Escapes e interpolación",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FFF68F"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FEC9C3"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#FFF68F"
      }
    },
    {
      "name": "Funciones",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#BFD4F2"
      }
    },
    {
      "name": "Tipos y clases",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.namespace",
        "storage.type.sql"
      ],
      "settings": {
        "foreground": "#F06BB0"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#FFF0F5"
      }
    },
    {
      "name": "Parámetros",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#F5D2F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propiedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property-name",
        "support.variable.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#F6B9DB"
      }
    },
    {
      "name": "Preprocesador y macros",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "Includes",
      "scope": [
        "meta.preprocessor.include string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#8CFF3A"
      }
    },
    {
      "name": "Tags HTML/XML",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#FFB7C3"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D3F4DF"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "Decoradores y anotaciones",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "Lifetimes y atributos Rust",
      "scope": [
        "entity.name.type.lifetime",
        "meta.attribute.rust",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "ASM registros",
      "scope": [
        "variable.parameter.register",
        "support.variable.register",
        "storage.other.register",
        "variable.language.register",
        "constant.language.register",
        "register"
      ],
      "settings": {
        "foreground": "#FEC9C3"
      }
    },
    {
      "name": "ASM instrucciones",
      "scope": [
        "keyword.control.instruction",
        "support.function.mnemonic",
        "keyword.mnemonic",
        "keyword.other.instruction",
        "support.function.instruction"
      ],
      "settings": {
        "foreground": "#C38CFF"
      }
    },
    {
      "name": "ASM directivas",
      "scope": [
        "support.function.directive",
        "keyword.control.directive.asm",
        "storage.type.directive",
        "keyword.directive",
        "support.function.pseudo",
        "keyword.other.directive",
        "meta.directive"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "ASM etiquetas",
      "scope": [
        "entity.name.function.label",
        "entity.name.label",
        "meta.label",
        "entity.name.tag.label"
      ],
      "settings": {
        "foreground": "#BFD4F2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F06BB0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown énfasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F5D2F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown negrita",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F6B9DB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#8CFF3A"
      }
    },
    {
      "name": "Markdown enlaces",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#BFD4F2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown citas",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#C5C6E4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown listas",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered.bullet"
      ],
      "settings": {
        "foreground": "#C38CFF"
      }
    },
    {
      "name": "Diff insertado",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8CFF3A"
      }
    },
    {
      "name": "Diff borrado",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FFB7C3"
      }
    },
    {
      "name": "Diff cambiado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#BFD4F2"
      }
    },
    {
      "name": "Claves JSON",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#D3F4DF"
      }
    },
    {
      "name": "Claves YAML",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#FFB7C3"
      }
    },
    {
      "name": "Anclas YAML",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "CSS selectores",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#FFB7C3"
      }
    },
    {
      "name": "CSS pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "CSS propiedades",
