  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#C5C6E4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#E4C1F9"
      }
    },
    {
      "name": "Operadores y puntuación",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#B9B2B6"
      }
    },
    {
      "name": "Operadores con palabra",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#E4C1F9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D7FBCB"
      }
    },
    {
      "name": "Escapes e interpolación",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FEC9C3"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#FCF5BF"
      }
    },
    {
      "name": "Funciones",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#BFD4F2"
      }
    },
    {
      "name": "Tipos y clases",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.namespace",
        "storage.type.sql"
      ],
      "settings": {
        "foreground": "#FF99C9"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#FFF0F5"
      }
    },
    {
      "name": "Parámetros",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#F5D2F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propiedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property-name",
        "support.variable.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#F6B9DB"
      }
    },
    {
      "name": "Preprocesador y macros",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#F99DCE"
      }
    },
    {
      "name": "Includes",
      "scope": [
        "meta.preprocessor.include string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#D7FBCB"
      }
    },
    {
      "name": "Tags HTML/XML",
