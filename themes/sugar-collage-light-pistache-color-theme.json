  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#5E5F9E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#8A2BD0"
      }
    },
    {
      "name": "Operadores y puntuación",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7D6670"
      }
    },
    {
      "name": "Operadores con palabra",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.star.sql"
      ],
      "settings": {
        "foreground": "#8A2BD0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2F7A1A"
      }
    },
    {
      "name": "Escapes e interpolación",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#A8137A"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#B04A26"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7A6A00"
      }
    },
    {
      "name": "Funciones",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2563C0"
      }
    },
    {
      "name": "Tipos y clases",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.namespace",
        "storage.type.sql"
      ],
      "settings": {
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#414040"
      }
    },
    {
      "name": "Parámetros",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#7A3F6E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propiedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property-name",
        "support.variable.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#A8336E"
      }
    },
    {
      "name": "Preprocesador y macros",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#A8137A"
      }
    },
    {
      "name": "Includes",
      "scope": [
        "meta.preprocessor.include string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#2F7A1A"
      }
    },
    {
      "name": "Tags HTML/XML",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#C2364C"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#14784A"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#A8137A"
      }
    },
    {
      "name": "Decoradores y anotaciones",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#A8137A"
      }
    },
    {
      "name": "Lifetimes y atributos Rust",
      "scope": [
        "entity.name.type.lifetime",
        "meta.attribute.rust",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#A8137A"
      }
    },
    {
      "name": "ASM registros",
      "scope": [
        "variable.parameter.register",
        "support.variable.register",
        "storage.other.register",
        "variable.language.register",
        "constant.language.register",
        "register"
      ],
      "settings": {
        "foreground": "#B04A26"
      }
    },
    {
      "name": "ASM instrucciones",
      "scope": [
        "keyword.control.instruction",
        "support.function.mnemonic",
        "keyword.mnemonic",
        "keyword.other.instruction",
        "support.function.instruction"
      ],
      "settings": {
        "foreground": "#8A2BD0"
      }
    },
    {
      "name": "ASM directivas",
      "scope": [
        "support.function.directive",
        "keyword.control.directive.asm",
        "storage.type.directive",
        "keyword.directive",
        "support.function.pseudo",
        "keyword.other.directive",
        "meta.directive"
      ],
      "settings": {
        "foreground": "#A8137A"
      }
    },
    {
      "name": "ASM etiquetas",
      "scope": [
        "entity.name.function.label",
        "entity.name.label",
        "meta.label",
        "entity.name.tag.label"
      ],
      "settings": {
        "foreground": "#2563C0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#C2185B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown énfasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#7A3F6E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown negrita",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#A8336E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#2F7A1A"
      }
    },
    {
      "name": "Markdown enlaces",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#2563C0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown citas",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5E5F9E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown listas",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered.bullet"
      ],
      "settings": {
        "foreground": "#8A2BD0"
      }
    },
    {
      "name": "Diff insertado",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2F7A1A"
      }
    },
    {
      "name": "Diff borrado",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C2364C"
      }
    },
    {
      "name": "Diff cambiado",
      "scope": [
